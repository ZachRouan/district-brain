# Copy to .env and adjust. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-generate-a-real-one          # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=true                                        # false in production
ALLOWED_HOSTS=localhost,127.0.0.1                 # add the server's LAN hostname/IP in production
TIME_ZONE=America/New_York
DISTRICT_NAME=Maple Ridge USD                     # shown in the UI header; the default is the fictional demo district

# --- Database (docker-compose.yml reads these same values) ---
POSTGRES_DB=districtbrain
POSTGRES_USER=districtbrain
POSTGRES_PASSWORD=districtbrain
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54320

# --- Embeddings (always local; model downloads once, then works offline) ---
EMBEDDING_BACKEND=sentence_transformers           # or "hash" (deterministic, tests/dev only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM backend ---
# Mock backend answers deterministically from retrieved sources (no model needed).
# Swap to llama.cpp by setting: chat.llm.LlamaCppServerBackend
LLM_BACKEND=chat.llm.MockLLMBackend
LLAMA_SERVER_URL=http://127.0.0.1:8080            # llama.cpp server, only used by LlamaCppServerBackend
LLM_MAX_TOKENS=1024                               # cap on generated tokens per answer
# Reasoning models (Qwen3, etc.) waste the token budget thinking and can return an
# empty answer; District Brain disables thinking by default. Requires the llama.cpp
# server to run with --jinja. Set false only if you want a reasoning model to think.
LLM_DISABLE_THINKING=true

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=6                                 # max chunks handed to the LLM per question
RETRIEVAL_MAX_DISTANCE=0.60                       # cosine distance cutoff; larger = looser matching
# Hard ceilings retrieve() enforces on its own arguments; the defaults above sit well under them.
RETRIEVAL_TOP_K_CAP=20
RETRIEVAL_MAX_DISTANCE_CAP=1.0

# --- Abuse limits ---
ASK_MAX_QUESTION_CHARS=2000                       # longer questions are rejected, nothing stored
ASK_RATE_LIMIT_PER_MINUTE=30                      # per user; 0 disables

# --- Google Workspace SSO (optional; local accounts work without it) ---
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
